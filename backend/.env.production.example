# PRODUCTION settings. Copy to .env.production (or set these in your host's dashboard). NEVER commit real values.
ENVIRONMENT=production
DEBUG=false
APP_NAME=KORA EATS

# --- Database (Neon / managed PostgreSQL). Neon requires TLS: keep sslmode=require.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Security. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
FRONTEND_BASE_URL=https://YOUR-DOMAIN
CORS_ORIGINS=https://YOUR-DOMAIN
# How many proxies sit in front of the app (e.g. 1 behind Render/Caddy) so rate limits see real client IPs.
TRUSTED_PROXY_HOPS=1
# Start with report-only, watch /api/csp-report in the logs, then switch to enforce.
CSP_MODE=report-only
API_RATE_LIMIT_PER_MINUTE=300

# --- Payments (Paystack). Use sk_test_... first, then sk_live_...
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
ENABLED_PAYMENT_METHODS=MOBILE_MONEY
# Webhook URL to set in the Paystack dashboard:  https://YOUR-DOMAIN/api/payments/webhook/paystack

# --- Email (Resend). Verify your sending domain first.
RESEND_API_KEY=
EMAIL_FROM=KORA EATS <orders@YOUR-DOMAIN>
GOOGLE_CLIENT_ID=

# --- Web push (python -m scripts.generate_vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@YOUR-DOMAIN

# --- Files. Uploaded photos are stored on disk: mount a PERSISTENT volume here, or they are lost on every deploy.
UPLOAD_DIR=/data/uploads
WEB_CONCURRENCY=2
