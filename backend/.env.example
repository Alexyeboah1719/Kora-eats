# Copy to .env and edit. NEVER commit .env.
APP_NAME=KORA EATS
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://foodapp:foodapp_dev_pw@localhost:5432/foodapp_dev
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Phase 2: authentication ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
FRONTEND_BASE_URL=http://localhost:8000
# Email (Resend). Leave empty in development: emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=KORA EATS <onboarding@resend.dev>
# Google sign-in. Leave empty to disable the Google button.
GOOGLE_CLIENT_ID=

# --- Payments ---
# dev = built-in simulator (development only). paystack = real payments (https://paystack.com/docs/api/).
PAYMENT_PROVIDER=dev
# Paystack dashboard -> Settings -> API Keys & Webhooks. SERVER ONLY. Use the test key (sk_test...) until you go live.
PAYSTACK_SECRET_KEY=
# Mobile Money works first. Add CARD and/or BANK_TRANSFER once they're enabled on your Paystack account, e.g. MOBILE_MONEY,CARD
ENABLED_PAYMENT_METHODS=MOBILE_MONEY
# Set this webhook URL in the Paystack dashboard:  https://YOUR-DOMAIN/api/payments/webhook/paystack
